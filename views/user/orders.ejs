    <script>
        document.addEventListener("DOMContentLoaded", () => {
            // Select all buttons with the class 'complete-payment-btn'
            const paymentButtons = document.querySelectorAll(".complete-payment-btn");
    
            paymentButtons.forEach((button) => {
                button.addEventListener("click", async function() {
                    const orderId = this.getAttribute("data-order-id");
                    console.log("inside click for order ID:", orderId); // Added context to the log
                    try {
                        // Fetch payment data from the server
                        const response = await fetch("/myAccount/orders/repayment", {
                            method: 'POST',
                            headers: {
                                'Content-Type': 'application/json',
                            },
                            body: JSON.stringify({ orderId }),
                        });
    
                        const data = await response.json();
    
                        if (!data.success) {
                            console.log("Payment initiation failed: data not successful"); // More descriptive log
                            throw new Error(data.message);
                        }
    
                       
                        const options = {
                            key: 'rzp_test_4uxjS6fUMPYvzS', 
                            amount: data.amount * 100, 
                            currency: data.currency,
                            name: 'Your Store Name',
                            order_id: data.orderId, 
                            handler: async (response) => {
                                try {
                                    
                                    const confirmResponse = await fetch('/productDetails/cart/checkout/verification', {
                                        method: 'POST',
                                        headers: {
                                            'Content-Type': 'application/json',
                                        },
                                        body: JSON.stringify({
                                            paymentId: response.razorpay_payment_id,
                                            orderId: orderId,
                                        }),
                                    });
    
                                    const result = await confirmResponse.json();
    
                                    if (result.success) {
                                        alert('Payment confirmed! Your order has been placed successfully.');
                                        window.location.href = '/productDetails/cart/checkout/success';
                                    } else {
                                        alert('Payment confirmation failed. Please try again.');
                                    }
                                } catch (error) {
                                    console.error("Error during payment confirmation:", error);
                                    alert("An error occurred while confirming your payment.");
                                }
                            },
                            theme: {
                                color: '#F37254', // Custom theme color
                            },
                        };
    
                        // Initialize Razorpay and open the payment modal
                        const razorpay = new Razorpay(options);
                        razorpay.open();
                        razorpay.on('payment.failed', async (response) => {
                            console.error("Payment Failed", response);
                            alert("Payment failed. Please try again.");
                            window.location.href='/myAccount/orders'
                        });
                    } catch (error) {
                        console.error("Payment initiation failed:", error);
                        alert("Failed to initiate payment. Please try again.");
                    }
                });
            });
        });
    </script>

    
    

