
<%- include('../partials/user/header') %>
<style>
    .pagination {
          display: flex;
          justify-content: center;
          margin-bottom: 50px;
        }
        .pagination .page-item {
          margin: 0 5px;
        }
        .acti{
            background-color: rgb(189, 189, 248);
            width: 20px;
            height: 20px;
            text-align: center;
        }
        .order-cancel-btn{
            background-color: #9e9b9b;
        }
    
</style>
<link rel="stylesheet" href="/css/orders.css">
    <div class="orders-list">
        <h2>Your Orders</h2>
    
        <!-- Order Card 1 -->
         <% if(typeof orderItems !== 'undefined'){ %>
            <% for(let i=0;i<orderItems.length;i++){ %>
                <% for(let j=0;j<orderItems[i].cartItems.length;j++){ %>
                    <div class="order-card">
                        <div class="order-image">
                            <img src="/uploads/<%= orderItems[i].cartItems[j].product.croppedImage[0] %>" alt="Product Image">
                            
                        </div>
                       
                        <div class="order-info">
                            <div class="order-details">
                                <h3><%= orderItems[i].orderId %></h3>
                                <p><strong>Date:</strong> <%=dateField[i]  %> </p>
                                <p><strong>Status:</strong><%= orderItems[i].cartItems[j].orderStatus %></p>
                                <% if(orderItems[i].cartItems[j].orderStatus === 'Delivered'){ %>
                                <button 
                                    class="downloadInvoice"
                                    data-product-orderId="<%= orderItems[i].orderId %>"
                                    data-product-name="<%= orderItems[i].cartItems[j].product.name %>"
                                    data-product-price="<%= orderItems[i].cartItems[j].price %>"
                                    data-product-quantity="<%= orderItems[i].cartItems[j].quantity %>"
                                    data-product-size="<%= orderItems[i].cartItems[j].size %>"
                                    data-product-discount="<%= 
                                        (
                                            ((orderItems[i].cartItems[j].price - 
                                            orderItems[i].cartItems[j].offerPrice) *
                                            orderItems[i].cartItems[j].quantity) -
                                            orderItems[i].cartItems[j].couponDiscount
                                        ).toFixed(2)  
                                    %>"
                                    data-product-total="<%= orderItems[i].cartItems[j].finalAmount %>"
                                    data-user-address="<%= JSON.stringify(orderItems[i].address)  %>"
                                    >DOWNLOAD INVOICE
                                </button>
                                <%}%>
                                
                            </div>
                
                            <div class="item-details">
                                <h4>Items:</h4>
                                <ul>
                                    <li>
                                        <p><strong>Product : </strong><%= orderItems[i].cartItems[j].product.name %></p>
                                        <p><strong>Quantity : </strong><%= orderItems[i].cartItems[j].
                                            quantity %></p>
                                        <p><strong>Price : </strong><%= orderItems[i].cartItems[j].price %></p>
                                        <p><strong>Size : </strong><%= orderItems[i].cartItems[j].size %></p>
                                    </li>
                                </ul>
                                <p><strong>Total:</strong><%= orderItems[i].cartItems[j].finalAmount %></p>
                            </div>
                        </div>
                        
                        <div id="invoicePDF" style="display: none;">
                            <!-- Header section for company logo and details -->
                            <div style="display: flex; justify-content: space-between; align-items: center; padding-bottom: 20px;">
                                <!-- Company Logo -->
                                <div>
                                    <img src="/images/logo.png" alt="Company Logo" style="height: 50px;">
                                </div>
                                <!-- Company Details -->
                                <div style="text-align: right;">
                                    <p id="companyName"><strong>Company Name</strong></p>
                                    <p id="companyAddress">123 Business Rd.</p>
                                    <p id="companyCity">City, State, Zip</p>
                                    <p id="companyEmail">Email: contact@company.com</p>
                                    <p id="companyPhone">Phone: (123) 456-7890</p>
                                </div>
                            </div>
                        
                            <!-- Divider Line -->
                            <hr style="border-top: 1px solid #000; margin: 20px 0;">
                        
                            <!-- Order and Customer Details -->
                            <div id="orderDetails" style="margin-bottom: 20px;">
                                <p><strong>Order ID:</strong> <span id="pdfOrderID"></span></p>
                                <p><strong>Date:</strong> <span id="pdfOrderDate"></span></p>
                                <p><strong>Customer Name:</strong> <span id="pdfCustomerName"></span></p>
                            </div>
                        
                            <!-- Shipping Address (added below the divider) -->
                            <div style="text-align: right; margin-bottom: 20px;">
                                <p><strong>Shipping Address:</strong></p>
                                <p id="pdfShippingAddress">
                                </p>
                            </div>
                        
                            <!-- Product Details -->
                            <table style="width: 100%; border-collapse: collapse;">
                                <thead>
                                    <tr>
                                        <th id="productHeader">Product</th>
                                        <th id="quantityHeader">Quantity</th>
                                        <th id="sizeHeader">Size</th>
                                        <th id="priceHeader">Price</th>
                                        <th id="discountHeader">Discount</th>
                                        <th id="totalHeader">Total</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr>
                                        <td id="pdfProductName"></td>
                                        <td id="pdfProductQuantity"></td>
                                        <td id="pdfProductSize"></td>
                                        <td id="pdfProductPrice"></td>
                                        <td id="pdfProductDiscount"></td>
                                        <td id="pdfProductTotal"></td>
                                    </tr>
                                </tbody>
                            </table>
                        
                            <!-- Total Amount -->
                            <div id="totalAmountSection" style="text-align: right; margin-top: 20px;">
                                <p><strong>Total Amount: <span id="pdfTotalAmount"></span></strong></p>
                            </div>
                        </div>
                        
                
                        <!-- Order Actions -->
                        <div class="order-actions">
                            <button class="track-btn"><a style="color: #fff;" href="/myAccount/orders/trackOrder?id=<%= orderItems[i]._id %>">Track Order</a></button>
                            <% if (orderItems[i].cartItems[j].orderStatus === 'Pending'){ %>
                                <button class="complete-payment-btn" id="complete-payment-btn"  data-order-id="<%= orderItems[i]._id %>" >Complet Payment </button>
                            <% } else{ %>
                                <% if(orderItems[i].cartItems[j].orderStatus !== 'Delivered' && orderItems[i].cartItems[j].orderStatus !== 'Returned' ){ %>

                                    <% if (orderItems[i].cartItems[j].orderStatus !== 'Cancelled' && orderItems[i].cartItems[j].cancelAccept!== 'reject' && orderItems[i].cartItems[j].isCancel !== true ) { %>
                                        <button class="cancel-btn" ><a style="color: #fff;" href="/myAccount/orders/cancelOrder?orderId=<%=orderItems[i]._id%>&cartItem=<%=orderItems[i].cartItems[j]._id%>">Cancel Order</a></button>
                                     <% } else if(orderItems[i].cartItems[j].cancelAccept === "Accept"){ %>
                                        <p>Cancelled</p>
                                    <% }else if(orderItems[i].cartItems[j].cancelAccept === "Rejected"){ %>
                                        <p>Rejected</p>
                                    <% } %>
                                        
                                <% }else{ %>
                                    <% if(orderItems[i].cartItems[j].isReturn === false){ %>
                                        <button class="cancel-btn"><a style="color: #fff;" href="/myAccount/orders/returnOrder?orderId=<%=orderItems[i]._id%>&cartItem=<%=orderItems[i].cartItems[j]._id%>">Return</a></button>
                                    <% } else{ %>
                                            <% if(orderItems[i].cartItems[j].returnAccept === "Accept"){ %>
                                                <P>Returned</P>
                                            <% } else if(orderItems[i].cartItems[j].returnAccept === "Rejected"){%>
                                                <P>ReJected</P>
                                            <% } %>
                                    <% } %>
                                    
                                <% } %>
                            <% } %>
                            
                            
                        </div>
                    </div>
                <% } %>
                
            <% } %>
            
         <% } %>
        
    
        <!-- Repeat for more orders -->
    </div>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.9.2/html2pdf.bundle.min.js"></script>

    <script src="https://checkout.razorpay.com/v1/checkout.js"></script>

    <script>
        const invoiceButton=document.querySelectorAll(".downloadInvoice")
        invoiceButton.forEach((button)=>{
            button.addEventListener("click",function(){

                const orderDetails={
                    orderID: this.getAttribute("data-product-orderId"),
                    orderDate: '2024-11-04',
                    customerName: 'John Doe',
                    product: {
                        name: this.getAttribute("data-product-name"),
                        quantity: this.getAttribute("data-product-quantity"),
                        size:this.getAttribute("data-product-size"),
                        discount:this.getAttribute("data-product-discount"),
                        price: this.getAttribute("data-product-price")
                    },
                    totalAmount: this.getAttribute("data-product-total")
                }
                const addressData = JSON.parse(this.getAttribute("data-user-address"));
                // const address={

                // }

                console.log(orderDetails)
                console.log(addressData)

                function populatePDFInvoice(details) {
                    document.getElementById('pdfOrderID').textContent = details.orderID;
                    document.getElementById('pdfOrderDate').textContent = details.orderDate;
                    document.getElementById('pdfCustomerName').textContent = details.customerName;
                    document.getElementById('pdfProductName').textContent = details.product.name;
                    document.getElementById('pdfProductQuantity').textContent = details.product.quantity;
                    document.getElementById("pdfProductSize").textContent=details.product.size
                    document.getElementById('pdfProductPrice').textContent = details.product.price;
                    document.getElementById("pdfProductDiscount").textContent= details.product.discount;
                    document.getElementById('pdfProductTotal').textContent = details.totalAmount;
                    document.getElementById('pdfTotalAmount').textContent = details.totalAmount;
                    document.getElementById("pdfShippingAddress").innerHTML = `
                        ${addressData.street}, ${addressData.village}<br>
                        ${addressData.pincode}, ${addressData.city}
                    `;
                }

                populatePDFInvoice(orderDetails);

                const invoice = document.getElementById("invoicePDF");
                invoice.style.display = "block"; 
                const options = {
                    margin: 0.5,
                    filename: 'invoice.pdf',
                    image: { type: 'jpeg', quality: 0.98 },
                    html2canvas: { scale: 2 },
                    jsPDF: { unit: 'in', format: 'a4', orientation: 'portrait' }
                };
                html2pdf().from(invoice).set(options).save();


            })
        })
    </script>


