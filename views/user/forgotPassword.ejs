<%- include('../partials/user/header') %>

<style>
    * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
    }

    .order-success-container {
        font-family: Arial, sans-serif;
        display: flex;
        justify-content: center;
        align-items: center;
        height: 100vh;
        background-color: #f9f9f9;
        flex-direction: column; /* Stack elements vertically */
    }

    form {
        width: 100%;
        max-width: 400px;
        background-color: white;
        padding: 20px;
        border-radius: 8px;
        box-shadow: 0 0 10px rgba(0, 0, 0, 0.1);
        margin-bottom: 20px; /* Space between form and no-user-found */
    }

    form h2 {
        text-align: center;
        margin-bottom: 20px;
    }

    label, input, button {
        width: 100%;
        display: block;
        margin-bottom: 15px;
    }

    input {
        padding: 10px;
        font-size: 16px;
        border: 1px solid #ccc;
        border-radius: 5px;
    }

    button {
        padding: 10px;
        font-size: 16px;
        background-color: #007bff;
        color: white;
        border: none;
        border-radius: 5px;
        cursor: pointer;
    }

    button:hover {
        background-color: #0056b3;
    }

    .no-user-found {
        text-align: center;
    }

    .no-user-found p {
        margin-bottom: 10px;
        color: red;
        font-weight: bold;
    }

    .no-user-found a {
        color: white;
        text-decoration: none;
    }

    .no-user-found button {
        padding: 10px;
        font-size: 16px;
        background-color: #28a745;
        color: white;
        border: none;
        border-radius: 5px;
        cursor: pointer;
    }

    .no-user-found button:hover {
        background-color: #218838;
    }

    /* Responsive Design */
    @media (max-width: 600px) {
        form, .no-user-found {
            width: 90%;
        }
    }
</style>

<div class="order-success-container">
    <form  id="resetPassword-form">
        <h2>Forgot Your Password?</h2>
        
        <label for="email">Enter your registered email address:</label>
        <input type="email" name="email" required>
        
        <button type="submit">Send Reset Link</button>
    </form>
   
    
</div>

<script>
    document.addEventListener("DOMContentLoaded",()=>{
        const resetForm=document.getElementById("resetPassword-form")
        

        resetForm.addEventListener("submit",async function(e){
            e.preventDefault()
            const email=resetForm.email.value
            console.log("inside form submission")
            console.log(email)

            try {
                const response=await fetch("/forgotPassword",{
                    method:"POST",
                    headers:{
                        "Content-Type": "application/json"
                    },
                    body:JSON.stringify({email:email})
                })
                const data=await response.json()
                console.log(data)
                if(response.ok && data.success){
                    console.log("email sended")
                    alert(data.message)
                    
                    
                }else{
                    console.log("email not sended")
                    alert(data.message)
                    const resetURL=data.url
                    window.location.href = resetURL;
                }
            } catch (error) {
                console.log("error in fetch")
                console.log(error)
                
            }
            
        })
    })
</script>

<%- include('../partials/user/footer') %>