<%- include('../partials/user/header') %>
    <style>
        .reset-body {
            font-family: Arial, sans-serif;
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
            margin: 0;
            background-color: #f9f9f9;
        }

        .reset-password-container {
            background: #ffffff;
            padding: 20px;
            border-radius: 10px;
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
            max-width: 400px;
            width: 100%;
        }

        .reset-password-title {
            font-size: 24px;
            margin-bottom: 20px;
            text-align: center;
            color: #333;
        }

        .reset-password-form-group {
            margin-bottom: 15px;
        }

        .reset-password-label {
            display: block;
            margin-bottom: 8px;
            font-weight: bold;
            color: #555;
        }

        .reset-password-input {
            width: 100%;
            padding: 10px;
            font-size: 16px;
            border: 1px solid #ccc;
            border-radius: 5px;
            box-sizing: border-box;
        }

        .reset-password-input:focus {
            border-color: #007bff;
            outline: none;
        }

        .reset-password-error-message {
            color: #d9534f;
            font-size: 14px;
            margin-top: 5px;
        }

        .reset-password-button {
            width: 100%;
            padding: 12px;
            font-size: 16px;
            color: #fff;
            background: #007bff;
            border: none;
            border-radius: 5px;
            cursor: pointer;
            text-align: center;
        }

        .reset-password-button:hover {
            background: #0056b3;
        }

        @media (max-width: 480px) {
            .reset-password-container {
                padding: 15px;
            }

            .reset-password-title {
                font-size: 20px;
            }

            .reset-password-button {
                font-size: 14px;
            }
        }
    </style>

<div class="reset-body">
    <div class="reset-password-container">
        <h1 class="reset-password-title">Reset Password</h1>
        <form id="resetPasswordForm" action="/">
            <div class="reset-password-form-group">
                <label for="resetPassword" class="reset-password-label">New Password</label>
                <input
                    type="password"
                    id="resetPassword"
                    name="new_password"
                    class="reset-password-input"
                    
                />
                <p class="reset-password-error-message" id="resetPasswordError"></p>
            </div>
            <div class="reset-password-form-group">
                <label for="confirmResetPassword" class="reset-password-label">Confirm Password</label>
                <input
                    type="password"
                    id="confirmResetPassword"
                    name="confirm_password"
                    class="reset-password-input"
                    
                />
                <p class="reset-password-error-message" id="confirmResetPasswordError"></p>
            </div>
            <button type="submit" class="reset-password-button">Reset Password</button>
        </form>
    </div>
</div>
   

    <script>
        const resetForm = document.getElementById("resetPasswordForm");
        const passwordInput = document.getElementById("resetPassword");
        const confirmPasswordInput = document.getElementById("confirmResetPassword");
        const passwordError = document.getElementById("resetPasswordError");
        const confirmPasswordError = document.getElementById("confirmResetPasswordError");
        const token='<%= token %>'

        resetForm.addEventListener("submit", async (e) => {
            e.preventDefault();

            // Clear previous errors
            passwordError.textContent = "";
            confirmPasswordError.textContent = "";

            const password = passwordInput.value;
            const confirmPassword = confirmPasswordInput.value;

            // Check password strength
            const passwordRegex = /^(?=.*[a-zA-Z])(?=.*\d)(?=.*[@$!%*?&#])[A-Za-z\d@$!%*?&#]{8,}$/;
            if (!passwordRegex.test(password)) {
                passwordError.textContent =
                    "Password must be at least 8 characters long and include uppercase, lowercase, number, and special character.";
                return;
            }

            // Check if passwords match
            if (password !== confirmPassword) {
                confirmPasswordError.textContent = "Passwords do not match.";
                return;
            }

            // Fetch API call to the backend
            try {
                const response = await fetch(`/reset-password/${token}`, { 
                    method: "POST",
                    headers: {
                        "Content-Type": "application/json",
                    },
                    body: JSON.stringify({ password }),
                });

                if (!response.ok) {
                    // Handle errors from the server
                    const errorData = await response.json();
                    passwordError.textContent = errorData.message || "An error occurred. Please try again.";
                    return;
                }

                // Success handling
                if (response.ok) {
                    const data = await response.json();
                    alert(data.message); // This will now work since `message` is sent from the server
                    resetForm.reset();
                    window.location.href='/login'
                    return;
                }
            } catch (error) {
                console.error("Error:", error);
                passwordError.textContent = "An unexpected error occurred. Please try again.";
            }
        });

    </script>
<%- include('../partials/user/footer') %>
