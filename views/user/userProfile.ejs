<%- include('../partials/user/header') %>

<link rel="stylesheet" href="/css/profile.css">
    

<div class="doby">


    <div class="myaccount-page">
        <div class="myaccount-card">
            <!-- User Header Section -->
            <div class="account-header">
                <h1>My Account</h1>
                <button class="btn" id="editProfileBtn"><a style="color: #fff;" href="/myAccount/editAccount">Edit Profile</a></button>
            </div>

            <!-- Profile Section -->
            <div class="profile-section">
                <div class="profile-photo">
                    <svg class="profile-image-placeholder" viewBox="0 0 20 20">
                        <path fill-rule="evenodd" d="M10 9a3 3 0 100-6 3 3 0 000 6zm-7 9a7 7 0 1114 0H3z" clip-rule="evenodd" />
                    </svg>
                    
                </div>

                <div class="profile-info">
                    <h2>About</h2>
                    <% if(typeof userData !== 'undefined'){ %>
                        <div class="info-group">
                            <label>User ID</label>
                            <p><%= userData.username %></p>
                        </div>
                        <div class="info-group">
                            <label>Name</label>
                            <p><%= userData.firstName %></p>
                        </div>
                        <div class="info-group">
                            <label>Email</label>
                            <p><%= userData.email %></p>
                        </div>
                        <div class="info-group">
                            <label>phoneNumber</label>
                            <p><%= userData.phoneNumber %></p>
                        </div>
                        <div class="info-group">
                            <label>Referral code</label>
                            <p><%= userData.referral %></p>
                        </div>
                    <% } %>
                    
                </div>
                <% if(typeof referalStatus !== 'undefined'){ %>

                        <% if(referalStatus.isActive === true  && userData.referralClimed === true){ %>
                            <div id="referral-containner">
                                <form action="" id="referralForm">
                                    
                                    <input type="text" placeholder="Apply Referral Code" id="referralCode">
                                    <span id="error1"></span>
                                    <button class="btn btn-success" type="submit" id="referralSubmit">Apply</button>
                                    <input type="hidden" value="<%= userData.referral %>" id="currentReferral">
                                    <input type="hidden" value="<%= userData._id %>" id="hiddenId">
                                </form>
                            </div>
                        <% }else if(referalStatus.isActive === false  && userData.referralClimed === true) { %>
                            <div>
                                <p style="color: rgb(236, 66, 66);">NO REFERRAL <br>OFFER RUNNING</p>
                            </div>
                        <% } %>
                <% } %>
                
            </div>

            <!-- Divider -->
            <hr>

            <!-- Additional Information Section -->
            <div class="additional-info">
                <h3>Additional Information</h3>
                <ul class="list-group">
                    <li><a href="/myAccount/resetPassword">Reset Password</a></li>
                    <li><a href="/myAccount/address">Addresses</a></li>
                    <li><a href="/myAccount/orders">Orders</a></li>
                    <li><a href="/productDetails/wishlist">Wishlist</a></li>
                    <li><a href="/myAccount/wallet">Wallet</a></li>
                </ul>
            </div>
            
        </div>
    </div>
</div>

    <% if(message) { %>
        <script>
            alert("<%- message %>");
        </script>
    <% } %>
    
    <script>
        const referralForm=document.getElementById("referralForm")
        const submitButton=document.getElementById("referralSubmit")
        const hiddenCode=document.getElementById("currentReferral")
        const referralCode=document.getElementById("referralCode")
        const hiddenId=document.getElementById("hiddenId")
        const referralContainer=document.getElementById("referral-containner")
        const error1=document.getElementById("error1")


        document.addEventListener("DOMContentLoaded",()=>{
            referralForm.addEventListener("submit",async(e)=>{
                e.preventDefault()
                
                if(referralCode.value.trim() === ''){
                    error1.innerHTML="enter a text"
                    error1.style.color='red'
                    return;
                }
                try {
                    const response=await fetch('/couponApply',{
                        method:"POST",
                        headers:{
                            'Content-Type': 'application/json',
                        },
                        body:JSON.stringify({
                            id:hiddenId.value,
                            currentCode:hiddenCode.value,
                            referralCode:referralCode.value
                        })
                    })

                    const data=await response.json()

                    if(data.isValid){
                        console.log("offer applied")
                        showToast(data.message,1)

                        referralContainer.remove()
                    }else{
                        console.log("offer not applyed")
                        showToast(data.message,0)
                    }
                } catch (error) {
                    console.log("error in fetch "+error)
                }
            })

            function showToast(message,isSuccess) {
            
                const toast = document.createElement('div');
                toast.innerText = message;

                
                toast.style.position = 'fixed';
                toast.style.bottom = '200px'; 
                toast.style.left = '50%'; 
                toast.style.transform = 'translateX(-50%)';
                toast.style.backgroundColor = isSuccess ? 'green' : 'red';
                
                toast.style.color = '#fff';
                toast.style.padding = '15px 30px'; 
                toast.style.borderRadius = '8px'; 
                toast.style.zIndex = '1000';
                toast.style.fontSize = '30px'; 
                toast.style.fontWeight= "bold"
                toast.style.maxWidth = '80%'; 
                toast.style.textAlign = 'center';
                

                
                document.body.appendChild(toast);

                
                setTimeout(() => {
                    document.body.removeChild(toast);
                }, 3000);
            }
        })
    </script>


   

<%- include('../partials/user/footer') %>
