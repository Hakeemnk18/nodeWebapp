
    
    <%- include('../partials/user/header') %>
    <style>
        .banner-container {
          height: 100vh;
          overflow: hidden;
          margin-bottom: 20px;
        }
    
        .banner-container img {
          width: 100%;
          height: 100%;
          object-fit: cover;
        }
    </style>

    <!-- Feadtued Categories -->

    <div class="banner-container">
        <img class="img-fluid" src="/images/Astronaut in outer space spacewalk elements of this image furnished by nasa.jpeg" alt="Banner Image">
    </div>

    <!-- Featured Products -->

    <div class="small-container">
        <h2 class="title">Featured Products</h2>
        <div class="row">
            <% if (typeof product !== 'undefined' && product.length >0){ %>
                <% for (let i=0;i < product.length  ; i++){ %>
                    <div class="col-4">
                        <a href="/productDetails?id=<%= product[i]._id %> "><img src="/uploads/<%= product[i].croppedImage[0] %>"></a>
                        <h4><%= product[i].name %></h4>
                        <div class="rating">
                            <i class="fa fa-star"></i>
                            <i class="fa fa-star"></i>
                            <i class="fa fa-star"></i>
                            <i class="fa fa-star"></i>
                            <i class="fa fa-star-o"></i>
                        </div>
                        <p><%= product[i].price %></p>
                    </div>
                <% } %>
            <% } %>
        </div>
        <h2 class="title">Latest Products</h2>
        <div class="row">
            <% if(typeof latestProduct !== 'undefined' && latestProduct.length>0){ %>

                <% for(let i=0;i<latestProduct.length;i++){ %>
                    <div class="col-4">
                        <a href="/productDetails?id=<%= latestProduct[i]._id %>"><img src="/uploads/<%= latestProduct[i].croppedImage[0] %>"></a>
                        <h4><%= latestProduct[i].name%></h4>
                        <div class="rating">
                            <i class="fa fa-star"></i>
                            <i class="fa fa-star"></i>
                            <i class="fa fa-star"></i>
                            <i class="fa fa-star"></i>
                            <i class="fa fa-star-o"></i>
                            
                        </div>
                        <p><%= latestProduct[i].price %></p>
                    </div>
                <% } %>
            <% } %>
            
        </div>
    </div>

    <!-- Offer -->
    <div class="offer">
        <div class="small-container">
            <div class="row">
                <div class="col-2">
                    <img src="/images/banner-cropped_image_1726580065808_2-removebg-preview.png" class="offer-img">
                </div>
                <div class="col-2">
                    <p>Exclusively Available on Astronex</p>
                    <h1>Comet Watcher Binoculars</h1>
                    <small>The Mi Smart Band 4 fearures a 39.9%larger (than Mi Band 3) AMOLED color full-touch display
                        with adjustable brightness, so everything is clear as can be.<br></small>
                    <a href="products.html" class="btn">Buy Now &#8594;</a>
                </div>
            </div>
        </div>
    </div>

